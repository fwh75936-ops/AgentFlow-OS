{
  "name": "agentflow-desktop",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "electron:dev": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@xyflow/react": "^12.3.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.454.0",
    "motion": "^14.14.0",
    "phaser": "^3.90.0",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "os.agentflow.app",
    "productName": "AgentFlow OS",
    "electronLanguages": [
      "zh-CN"
    ],
    "electronVersion": "33.4.11",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "backend-bundle",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ]
  },
  "dependencies": {
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  }
}
