# AgentFlow OS — AI computer sandbox, CentOS Stream
# ONE container shared by ALL agents: they share this environment, its
# /workspace volume and its desktop. Agents never get their own containers.
# Versions are selected with the BASE_IMAGE build arg (supported values:
# quay.io/centos/centos:stream10, quay.io/centos/centos:stream9); the built
# image is tagged per version, e.g. agentflow/sandbox:centos-stream-10.
# Same posture as the Ubuntu sandbox image: XFCE + TigerVNC + noVNC,
# non-root user agentflow, /workspace shared dir. Package management is dnf.
ARG BASE_IMAGE=quay.io/centos/centos:stream10
FROM ${BASE_IMAGE}

ENV DISPLAY=:1 \
    VNC_PORT=5901 \
    NOVNC_PORT=6080

# XFCE and TigerVNC live in EPEL on CentOS Stream; CRB provides some of
# their dependencies. Both repositories ship with the base image.
RUN dnf install -y epel-release \
    && dnf config-manager --set-enabled crb \
    && dnf install -y \
      xfce4-session xfce4-panel xfwm4 xfdesktop xfce4-terminal thunar \
      tigervnc-server tigervnc-server-minimal python3-websockify novnc \
      dbus-x11 xorg-x11-xauth \
      python3 python3-pip python3-pytest bash coreutils procps-ng sudo \
    && dnf clean all

# Non-root runtime user. sudo is NOT granted: agents run unprivileged and
# high-risk commands go through AgentFlow's human-approval gate instead.
RUN useradd -m -s /bin/bash agentflow && mkdir -p /workspace && chown agentflow:agentflow /workspace

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER agentflow
WORKDIR /workspace
EXPOSE 6080
# VNC itself (5901) is localhost-only inside the container (tigervnc -localhost
# yes) and is never published; only noVNC is published, bound to 127.0.0.1 by compose.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
